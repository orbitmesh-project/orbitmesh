# .NET build output, anywhere in the tree (per-project bin/obj already covered by
# nested .gitignore files where present - this is the safety net for the rest,
# e.g. OrbitMesh.Common, OrbitMesh.TestPackage).
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
.vs/
*.pdb
*.suo
*.user
*.userosscache
[Tt]est[Rr]esult*/
*.trx

# Locally-built NuGet packages - the real output goes to local-nuget/ (a sibling of this repo,
# see OrbitMesh.Common.csproj's PackageOutputPath), this just catches anything built elsewhere.
*.nupkg
*.snupkg

# Real, secret-bearing, runtime-mutated server/edge config - see
# src/orbitmesh-server/.gitignore and the matching appsettings.json.example files.
appsettings.json
appsettings.json.bak
!appsettings.json.example

# Build output - generated by cicd/*.ps1, not source.
cicd/build/

# Editor/OS cruft.
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.DS_Store
Thumbs.db
cicd/NuGet.Config
