<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-OrbitMesh.Edge-79cfbc5f-9cf9-4a22-9648-e7f505052633</UserSecretsId>
    <!-- Reported to the update server as the "from" version (see Services/EdgeVersion.cs) - bump
         this on every release meant to be offered as a self-update. -->
    <Version>1.1.4</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageReference Include="NLog.Extensions.Logging" Version="6.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OrbitMesh.Common\OrbitMesh.Common.csproj" />
  </ItemGroup>

  <!-- Packages/ is the Edge's own local runtime package storage (LocalPackagesDirectory in
       appsettings.json) - it lives inside this project folder for convenience, but the SDK's implicit
       globbing otherwise treats every file under here as project Content, silently bundling whatever
       happens to be locally deployed (including stale builds and any package's own settings.json) into
       every future build/publish output, on every platform. -->
  <ItemGroup>
    <Content Remove="Packages\**" />
    <None Remove="Packages\**" />
  </ItemGroup>
  <!-- instance-id.txt (InstanceIdProvider) is a runtime artifact too - same reasoning as Packages/ above. -->
  <ItemGroup>
    <Content Remove="instance-id.txt" />
    <None Remove="instance-id.txt" />
  </ItemGroup>
</Project>
