<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Public SDK surface, so missing-doc-comment warnings (CS1591) are worth actually seeing during
         development rather than suppressing - real IntelliSense for third-party package authors is the
         whole point of publishing this. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>OrbitMesh.Common</PackageId>
    <Version>1.2.0</Version>
    <Authors>Elie Bertret</Authors>
    <Copyright>Copyright © OrbitMesh</Copyright>
    <Description>The OrbitMesh Package SDK (PackageHost) and shared models - the .NET client library for writing OrbitMesh packages: settings, telemetry, messages and lifecycle for devices connected to an OrbitMesh Server.</Description>
    <PackageTags>orbitmesh;sdk;home-automation;iot;edge;automation</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/orbitmesh-project/orbitmesh</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
